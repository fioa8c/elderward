<?xml version="1.0"?>
<ruleset name="Elderward">
	<description>Security, database, WordPress-API and compatibility sniffs for Elderward. Formatting sniffs are left out on purpose: the code keeps its existing style.</description>

	<file>elderward.php</file>
	<file>uninstall.php</file>
	<file>bin</file>
	<file>includes</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Everything global must carry the plugin prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="elderward"/>
				<element value="Elderward"/>
				<element value="ELDERWARD"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB"/>
	<rule ref="WordPress.WP"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
	<rule ref="WordPress.PHP.DevelopmentFunctions"/>
	<rule ref="WordPress.PHP.NoSilencedErrors">
		<!-- The engine suppresses errors only where the failure is handled on the next line. -->
		<exclude-pattern>includes/engine/*</exclude-pattern>
	</rule>

	<!-- The engine and the standalone CLI stay runnable on PHP 5.6 hosts... -->
	<rule ref="PHPCompatibilityWP">
		<include-pattern>includes/engine/*</include-pattern>
		<include-pattern>bin/*</include-pattern>
	</rule>
	<config name="testVersion" value="5.6-"/>

	<!-- ...the WordPress side can rely on PHP 7.2 (WordPress' own minimum). -->
	<rule ref="PHPCompatibility.Classes.NewClasses.throwableFound">
		<exclude-pattern>includes/plugin/*</exclude-pattern>
	</rule>

	<!-- bin/elderward.php is a command-line script that never loads inside
	     WordPress: its top-level variables are its own, and it sets the
	     error/runtime configuration it needs like any CLI tool. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.runtime_configuration_error_reporting">
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.runtime_configuration_ini_set">
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>

	<!-- MysqliDb is the standalone CLI's database adapter: there is no $wpdb
	     outside WordPress. Inside WordPress the plugin injects the $wpdb adapter. -->
	<rule ref="WordPress.DB.RestrictedFunctions">
		<exclude-pattern>includes/engine/db.php</exclude-pattern>
	</rule>

	<!-- The engine runs outside WordPress too: it cannot use WordPress functions. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>includes/engine/*</exclude-pattern>
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<!-- The CLI prints to a terminal, through reporters that percent-encode control characters. -->
		<exclude-pattern>includes/engine/*</exclude-pattern>
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
</ruleset>
